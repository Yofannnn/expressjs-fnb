# ============================================
# APPLICATION IDENTITY CONFIGURATION
# ============================================
# Brand name of the application
BRAND_NAME="Your Brand Name"

# Support email address for customer service
SUPPORT_EMAIL="support@yourdomain.com"

# Base URL for the backend API
BASE_URL="https://api.yourdomain.com"

# Base URL for the client application
CLIENT_URL="https://yourdomain.com"

# ============================================
# STORE LOCATION CONFIGURATION
# ============================================
# Physical address of the store location
STORE_LOCATION_ADDRESS="123 Main Street, City, Country"

# Latitude coordinate of store location
STORE_LOCATION_LATITUDE=-6.2088

# Longitude coordinate of store location
STORE_LOCATION_LONGITUDE=106.8456

# ============================================
# DELIVERY FEE POLICY
# ============================================
# Base fee for delivery (in rupiah)
BASE_FEE=5000

# Distance (in km) covered by base fee
BASE_FEE_COVERS_UP_TO_KM=3

# Radius (in km) for free delivery
FREE_DELIVERY_RADIUS_KM=1

# Maximum delivery distance allowed (in km)
MAX_DELIVERY_DISTANCE_KM=30

# Additional rate per km beyond base coverage
PER_KM_RATE_BEYOND_BASE=1500

# ============================================
# EVENT BATCH CONFIGURATION
# ============================================
# Interval between batch flushes (in milliseconds)
EVENT_BATCH_FLUSH_INTERVAL_IN_MS=1000

# Maximum retry attempts for failed events
EVENT_BATCH_MAX_RETRIES=3

# Delay between retry attempts (in milliseconds)
EVENT_BATCH_RETRY_DELAY_IN_MS=1000

# Maximum wait time before force flushing (in milliseconds)
EVENT_BATCH_MAX_WAIT_TIME_IN_MS=1000

# Number of events per batch
EVENT_BATCH_SIZE=20

# ============================================
# EVENT QUEUE CONFIGURATION
# ============================================
# Maximum retry attempts for queue operations
EVENT_QUEUE_MAX_RETRIES=3

# Health check interval (in milliseconds)
EVENT_QUEUE_HEALTH_CHECK_INTERVAL=1000

# Batch timeout for queue processing (in milliseconds)
EVENT_QUEUE_BATCH_TIMEOUT=1000

# ============================================
# EVENT QUEUE PROCESSOR CONFIGURATION
# ============================================
# Number of events to process in a batch
EVENT_QUEUE_PROCESSOR_BATCH_SIZE=20

# Poll interval for queue processing (in milliseconds)
EVENT_QUEUE_PROCESSOR_POLL_INTERVAL_IN_MS=5000

# ============================================
# GUEST ORDER MANAGEMENT POLICY
# ============================================
# Maximum resend attempts per hour for guest orders
MAX_RESEND_GUEST_ORDER_MANAGEMENT_ATTEMPTS_PER_HOUR=3

# Cooldown period between resend attempts (in seconds)
GUEST_ORDER_MANAGEMENT_RESEND_COOLDOWN_IN_SECONDS=60

# Token expiry duration (in hours)
GUEST_ORDER_MANAGEMENT_TOKEN_EXPIRY_IN_HOURS=24

# ============================================
# JWT CONFIGURATION
# ============================================
# JWT access token secret (minimum 32 characters)
JWT_ACCESS_SECRET="your-super-secret-access-key-min-32-chars"

# JWT refresh token secret (minimum 32 characters)
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars"

# ============================================
# LOGIN SECURITY POLICY
# ============================================
# Account lock duration after failed attempts (in minutes)
ACCOUNT_LOCK_DURATION_IN_MINUTES=5

# Maximum login attempts before account lock
MAX_LOGIN_ATTEMPTS=5

# ============================================
# MIDTRANS PAYMENT GATEWAY
# ============================================
# Midtrans server key
MIDTRANS_SERVER_KEY="your-midtrans-server-key"

# Production mode (true/false)
MIDTRANS_IS_PRODUCTION=false

# Midtrans Snap API base URL
MIDTRANS_SNAP_BASE_URL="https://app.sandbox.midtrans.com/snap/v1"

# Midtrans Core API base URL
MIDTRANS_CORE_API_BASE_URL="https://api.sandbox.midtrans.com/v2"

# ============================================
# NODEMAILER EMAIL CONFIGURATION
# ============================================
# SMTP server host
EMAIL_HOST="smtp.gmail.com"

# SMTP server port
EMAIL_PORT=465

# SMTP authentication user (email address)
EMAIL_USER="your-email@gmail.com"

# SMTP authentication password
EMAIL_PASSWORD="your-app-password"

# ============================================
# ORDER CONSTRAINT POLICY
# ============================================
# Minimum order quantity allowed
MINIMUM_ORDER_QUANTITY=1

# Order expiration duration (in minutes)
ORDER_EXPIRY_IN_MINUTES=15

# ============================================
# PASSWORD RESET POLICY
# ============================================
# Cooldown between password reset attempts (in seconds)
PASSWORD_RESET_RESEND_COOLDOWN_IN_SECONDS=60

# Password reset token expiry (in minutes)
PASSWORD_RESET_EXPIRY_IN_MINUTES=15

# Grace period for password reset (in milliseconds)
PASSWORD_RESET_GRACE_PERIOD_IN_MS=30000

# Maximum password reset attempts per hour
MAX_RESEND_PASSWORD_RESET_ATTEMPTS_PER_HOUR=3

# ============================================
# PRICING POLICY
# ============================================
# Order types that service charge applies to (comma-separated)
SERVICE_CHARGE_APPLICABLE_TYPES="ONLINE,DINEIN"

# Service charge rate percentage
SERVICE_CHARGE_RATE_PERCENT=5

# Tax rate percentage
TAX_RATE_PERCENT=11

# ============================================
# PRISMA DATABASE CONFIGURATION
# ============================================
# PostgreSQL database connection URL
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# ============================================
# RATE LIMIT CONFIGURATION
# ============================================
# Cooldown period when circuit is open (in milliseconds)
RATE_LIMIT_COOLDOWN_PERIOD_IN_MS=30000

# Strategy when error occurs (allow/deny)
RATE_LIMIT_ERROR_STRATEGY="allow"

# Strategy when circuit is open (allow/deny/throttle)
RATE_LIMIT_CIRCUIT_OPEN_STRATEGY="throttle"

# Enable security alerts (true/false)
RATE_LIMIT_SECURITY_ALERTS=true

# ============================================
# REDIS CONFIGURATION
# ============================================
# Redis server host
REDIS_HOST="localhost"

# Redis server port
REDIS_PORT=6379

# Redis connection timeout (in milliseconds)
REDIS_CONNECT_TIMEOUT_IN_MS=1000

# Maximum retry attempts for Redis operations
REDIS_MAX_RETRIES=3

# ============================================
# SESSION POLICY
# ============================================
# Access token lifetime (in minutes)
ACCESS_TOKEN_LIFETIME_MINUTES=15

# Refresh token lifetime (in days)
REFRESH_TOKEN_LIFETIME_DAYS=30

# ============================================
# VERCEL BLOB STORAGE
# ============================================
# Vercel Blob storage read/write token
VERCEL_BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"

# Cache control max age for blobs (in months)
VERCEL_BLOB_CACHE_CONTROL_MAX_AGE_IN_MONTHS=12

# ============================================
# VERIFICATION EMAIL POLICY
# ============================================
# Email verification token expiry (in hours)
VERIFICATION_EMAIL_EXPIRY_IN_HOURS=24

# Cooldown between verification email resends (in seconds)
VERIFICATION_EMAIL_RESEND_COOLDOWN_IN_SECONDS=60

# Maximum verification email resend attempts per hour
MAX_RESEND_VERIFICATION_EMAIL_ATTEMPTS_PER_HOUR=3

# Hashing rounds for password hashing (bcrypt)
BCRYPT_ROUNDS=10
